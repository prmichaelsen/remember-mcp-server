{
  "extends": "../tsconfig.json",
  "compilerOptions": {
    "module": "ESNext",
    "moduleResolution": "bundler",
    "target": "ES2022",
    "lib": ["ES2022"],
    "types": ["node"],
    
    "outDir": "../dist/scripts",
    "rootDir": ".",
    
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    
    "baseUrl": "..",
    "paths": {
      "@/*": ["src/*"],
      "@scripts/*": ["scripts/*"]
    }
  },
  "include": ["./**/*", "../src/**/*"],
  "exclude": ["node_modules"]
}
